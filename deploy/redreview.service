# Private single-workspace deployment only; see docs/hosting.md.
[Unit]
Description=RedReview private review workspace
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=redreview
Group=redreview
WorkingDirectory=/opt/redreview
EnvironmentFile=-/etc/redreview.env
ExecStart=/usr/bin/python3 -m src.server --bind 127.0.0.1 --port 8844 --data /var/lib/redreview/redreview.sqlite3
Restart=on-failure
RestartSec=5
StateDirectory=redreview
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/redreview
[Install]
WantedBy=multi-user.target
